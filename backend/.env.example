# ------------------------------------------------------------------------------
# WhatsApp CRM backend configuration (multi-tenant). Copy to `.env` and fill in.
#
# NOTE: Per-business Meta credentials (access token, phone number id, WABA id,
# app id/secret, catalog id, payment config) are NO LONGER set here. Each
# business is onboarded in the Admin panel, which verifies the credentials with
# Meta and stores them against that tenant. Inbound webhooks are per tenant at
# /api/whatsapp/webhook/<businessId> with a per-tenant verify token.
# ------------------------------------------------------------------------------

# Server
PORT=5000
# Comma-separated list of allowed CORS origins, or * for any.
# Production: only the site's own address, e.g. https://app.example.com
# (the app calls the API from the same address, so nothing else needs it).
CORS_ORIGIN=*
# Public base URL — used to build each tenant's webhook callback URL.
PUBLIC_BASE_URL=http://localhost:5000

# Database — Supabase Postgres. Use the Session pooler connection string from
# Supabase → Project Settings → Database (URL-encode special characters in the
# password, e.g. @ → %40). Tables, columns and indexes are created on boot.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional pool size (default 10).
# DB_POOL_MAX=10

# Supabase project (used for account sign-up / login).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Service role key (Project Settings → API → service_role). Server only — it
# creates sign-up users with their email already confirmed.
SUPABASE_SERVICE_ROLE_KEY=

# Meta app (Tech Provider) for WhatsApp Embedded Signup.
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
# Verify token for the platform app's webhook (any long random string). The
# app's callback URL is set to <PUBLIC_BASE_URL>/api/whatsapp/webhook on boot.
# The same token verifies <PUBLIC_BASE_URL>/api/meta/webhook (Messenger and
# Instagram, both login methods).
META_WEBHOOK_VERIFY_TOKEN=

# Channel Status → Messenger / Instagram "Log in with Facebook": the Facebook
# Login for Business configuration id (App Dashboard → Facebook Login for
# Business → Configurations).
# META_BUSINESS_LOGIN_CONFIG_ID=
# Optional: a separate Pages-only configuration for the Messenger connect
# button, so its popup doesn't ask for Instagram. Unset = META_BUSINESS_LOGIN_CONFIG_ID.
# META_MESSENGER_LOGIN_CONFIG_ID=

# Channel Status → Instagram → "Log in with Instagram" (Business Login for
# Instagram, no Facebook Page needed). From App Dashboard → Instagram →
# API setup with Instagram login → 3. Set up Instagram business login →
# Business login settings. These are the Instagram app's id and secret, not
# META_APP_ID / META_APP_SECRET. The secret also signs that product's
# webhooks (checked on /api/meta/webhook). Unset = the option is shown as not
# set up and "Log in with Facebook" still works.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# Must exactly match an "OAuth redirect URI" in those settings. Unset =
# <PUBLIC_BASE_URL>/instagram-callback.html (the page in frontend/public).
# INSTAGRAM_REDIRECT_URI=https://139-84-141-28.sslip.io/instagram-callback.html
# Optional graph.instagram.com version (default v25.0).
# INSTAGRAM_GRAPH_VERSION=v25.0

# Auth — secret that signs login tokens. Production refuses to start unless it is
# at least 32 characters (e.g. openssl rand -hex 32).
AUTH_SECRET=change_me_to_a_long_random_secret
# Optional token lifetime in seconds (default 7 days).
# AUTH_TTL_SECONDS=604800

# Super admin (platform owner) login for the Admin panel.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change_me_password
# Better: store only a hash (node scripts/hash-admin-password.mjs). When set it
# replaces SUPER_ADMIN_PASSWORD. Changing either signs open admin sessions out.
# SUPER_ADMIN_PASSWORD_HASH=scrypt:<salt>:<hash>
# Admin session length in seconds (default 8 hours).
# ADMIN_TOKEN_TTL_SECONDS=28800

# Address the backend listens on (default: 127.0.0.1 in production, all
# interfaces otherwise). nginx is the public entry point.
# HOST=127.0.0.1

# Per-chat automation brake: more than LIMIT messages from one chat within
# WINDOW pauses that chat's bot for PAUSE (messages are still filed).
# CHAT_AUTOMATION_LIMIT=40
# CHAT_AUTOMATION_WINDOW_MS=300000
# CHAT_AUTOMATION_PAUSE_MS=600000

# Optional platform master password. Opens ANY business's CRM with that
# business's login email (or username / business name) plus this password,
# alongside their own password. For support access without touching a
# customer's credential. One shared secret for every tenant: whoever has it has
# every business, so keep it out of the repo and rotate it. Unset = disabled.
# PLATFORM_MASTER_PASSWORD=

# Default Graph API version used when a business doesn't specify one.
WA_GRAPH_VERSION=v21.0
# Marketing API version for the Ads page (connect, reports, Ads Manager). Meta
# retires Marketing API versions after about a year (v21.0 ended September
# 2025) and the Ads Manager payloads need v24.0 or newer. Below v24 every ads
# write (create, publish, edit, duplicate, bulk, uploads, audiences, rules,
# A/B tests, resume) is refused with 409 GRAPH_VERSION_TOO_OLD; reads and
# reports keep working. Unset, it falls back to WA_GRAPH_VERSION.
META_ADS_GRAPH_VERSION=v25.0
# Optional Ads Manager limits (defaults shown):
# ADS_VIDEO_UPLOADS_MAX=3          # ad videos sent to Meta at once (server-wide; one per business)
# ADS_AUDIENCE_CONCURRENCY=2       # custom audience uploads at once; the rest wait as "queued"

# Optional platform-level Meta app (fallback for template header uploads only;
# normally each business provides its own App ID / Secret).
# WA_APP_ID=
# WA_APP_SECRET=

# Optional generic auto-reply when a chat is NOT paused and has no automation.
AUTO_REPLY_ENABLED=false
AUTO_REPLY_TEXT=Thanks for your message! Our team will get back to you shortly.

# Bunny.net Storage (media hosting for inbound/outbound files + template headers)
BUNNY_STORAGE_ZONE=your_storage_zone
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_PASSWORD=your_storage_zone_password
# Public Pull Zone CDN host linked to the storage zone (serves the files).
BUNNY_CDN_URL=https://your_zone.b-cdn.net
# Account API key (bunny.net > Account Settings > API Key). Optional but
# recommended: without it, a deleted file is removed from storage yet keeps
# being served from the Pull Zone edge cache until its TTL expires.
BUNNY_API_KEY=

# WhatsApp Flows data-endpoint encryption (optional — only for endpoint-mode flows).
# WA_FLOW_PRIVATE_KEY_PATH=./keys/flow_private.pem
# WA_FLOW_KEY_PASSPHRASE=

# ---- Location → address (Ola Maps, falling back to OpenStreetMap) ----
# Ola Maps API key (server-side only). Leave empty to use OpenStreetMap only.
OLA_MAPS_API_KEY=
# Max Ola lookups per second from the queue (Ola enforces per-minute limits).
OLA_MAPS_RPS=5
# Ola OAuth client credentials (optional; the API key above is what's used).
OLA_MAPS_CLIENT_ID=
OLA_MAPS_CLIENT_SECRET=
# Redis for the rate-limited geocoding queue (1 lookup/second). If Redis isn't
# reachable the server falls back to an in-process limiter automatically.
REDIS_URL=redis://127.0.0.1:6379
# Optional: a contact email sent to Nominatim (its usage policy asks for one).
GEOCODE_CONTACT_EMAIL=
# Shared "try it" WhatsApp number (sandbox) for businesses that haven't connected
# their own number yet. It must live under the platform app (META_APP_ID), so its
# webhooks are signed with META_APP_SECRET.
SANDBOX_PHONE_NUMBER_ID=
SANDBOX_WABA_ID=
SANDBOX_APP_ID=
SANDBOX_DISPLAY_PHONE=
SANDBOX_ACCESS_TOKEN=
# Verify token for the sandbox callback (<PUBLIC_BASE_URL>/api/whatsapp/webhook/sandbox).
SANDBOX_WEBHOOK_VERIFY_TOKEN=
